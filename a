-- Main Loop
task.spawn(function()
    -- Sofort ersten Scan starten (Visual Mode)
    pcall(updateGUI, scan())
    status.Text = "VISUAL MODE"

    -- Sync parallel im Hintergrund versuchen
    task.spawn(function()
        for attempt = 1, 5 do
            if initSync() then
                status.Text = "SYNC ACTIVE"
                -- Sofort neu scannen mit Sync
                pcall(updateGUI, scan())
                break
            end
            task.wait(1)
        end
    end)

    -- Loop läuft im Hintergrund
    while sg and sg.Parent do
        task.wait(4 + math.random() * 2)
        pcall(updateGUI, scan())
    end
end)
