-- Synchronizer Bypass (exakt wie Heresy Hub)
local _syncChannels = nil
local _syncMod = nil

local function _channelCount(t)
    if type(t) ~= "table" then return 0 end
    local ok, hits = pcall(function()
        local h, n = 0, 0
        for _, v in next, t do
            n = n + 1
            if type(v) == "table" and type(rawget(v, "CacheTable")) == "table" then
                h = h + 1
            end
            if n >= 200 then break end
        end
        return h
    end)
    return (ok and hits) or 0
end

local function initSync()
    if _syncChannels then return true end

    local ok, mod = pcall(function()
        return require(ReplicatedStorage.Packages.Synchronizer)
    end)
    if not ok or type(mod) ~= "table" then return false end
    _syncMod = mod

    local gu = (debug and debug.getupvalue) or getupvalue
    if type(gu) ~= "function" then return false end

    -- Probe: mod.Get, Upvalue 9, dann Index 3 (genau wie Heresy)
    local function probe()
        local ok2, up = pcall(gu, mod.Get, 9)
        if ok2 and type(up) == "table" then
            local t3 = rawget(up, 3)
            if _channelCount(t3) > 0 then _syncChannels = t3; return true end
            if _channelCount(up) > 0 then _syncChannels = up; return true end
        end
        return false
    end

    if probe() then return true end

    -- Deep scan: alle Funktionen im Modul durchsuchen
    for fname, fn in next, mod do
        if type(fn) == "function" then
            for i = 1, 24 do
                local ok3, u = pcall(gu, fn, i)
                if not ok3 then break end
                if type(u) == "table" then
                    if _channelCount(u) > 0 then
                        _syncChannels = u; return true
                    end
                    for j = 1, 4 do
                        local sub = rawget(u, j)
                        if _channelCount(sub) > 0 then
                            _syncChannels = sub; return true
                        end
                    end
                end
            end
        end
    end

    return false
end

local function readChannel(ch, key)
    if type(ch) ~= "table" then return nil end
    local ct = rawget(ch, "CacheTable")
    if type(ct) ~= "table" then
        local ok, c2 = pcall(function() return ch.CacheTable end)
        if ok and type(c2) == "table" then ct = c2 end
    end
    if type(ct) ~= "table" then return nil end
    local v = rawget(ct, key)
    if v ~= nil then return v end
    local ok, v2 = pcall(function() return ct[key] end)
    return ok and v2 or nil
end

local function ownerIsMe(owner)
    if not owner then return false end
    if typeof(owner) == "Instance" and owner == LocalPlayer then return true end
    if type(owner) == "number" and owner == LocalPlayer.UserId then return true end
    if type(owner) == "string" then
        local o = owner:lower()
        return o == LocalPlayer.Name:lower() or o == LocalPlayer.DisplayName:lower()
    end
    if type(owner) == "table" then
        if owner.UserId == LocalPlayer.UserId then return true end
        if owner.Name and owner.Name:lower() == LocalPlayer.Name:lower() then return true end
    end
    return false
end

local function resolveOwner(owner)
    if not owner then return "?" end
    if typeof(owner) == "Instance" and owner:IsA("Player") then
        return owner.DisplayName or owner.Name
    end
    if type(owner) == "number" then
        local p = Players:GetPlayerByUserId(owner)
        return p and (p.DisplayName or p.Name) or tostring(owner)
    end
    if type(owner) == "string" and owner ~= "" then return owner end
    if type(owner) == "table" and owner.Name then return tostring(owner.Name) end
    return "?"
end

local function fmt(n)
    n = tonumber(n) or 0
    if n >= 1e12 then return string.format("%.2fT", n/1e12)
    elseif n >= 1e9 then return string.format("%.2fB", n/1e9)
    elseif n >= 1e6 then return string.format("%.2fM", n/1e6)
    elseif n >= 1e3 then return string.format("%.1fK", n/1e3)
    else return tostring(math.floor(n)) end
end

local function calcGen(idx, mut)
    if not AnimalsData or not AnimalsData[idx] then return 0 end
    local info = AnimalsData[idx]
    local base = tonumber(info.Generation or info.BaseGeneration) or 0
    local mult = 1
    if mut and mut ~= "None" then
        local ok, MutData = pcall(function()
            return require(ReplicatedStorage.Datas.Mutations)
        end)
        if ok and MutData and MutData[mut] then
            local d = MutData[mut]
            mult = mult + (tonumber(d.Modifier or d.MultiplierModifier or d.Multiplier) or 0)
        end
    end
    return math.floor(base * mult)
end

local function isMyPlotVisual(plot)
    local sign = plot:FindFirstChild("PlotSign")
    if not sign then return false end
    local yb = sign:FindFirstChild("YourBase")
    if yb and yb:IsA("BillboardGui") and yb.Enabled then return true end
    local gui = sign:FindFirstChildWhichIsA("SurfaceGui", true)
    if gui then
        for _, lbl in ipairs(gui:GetDescendants()) do
            if lbl:IsA("TextLabel") and lbl.Text then
                local t = lbl.Text:lower()
                if t:find(LocalPlayer.Name:lower(), 1, true)
                or t:find(LocalPlayer.DisplayName:lower(), 1, true) then
                    return true
                end
            end
        end
    end
    return false
end

local function getOwnerVisual(plot)
    local sign = plot:FindFirstChild("PlotSign")
    if not sign then return "?" end
    local gui = sign:FindFirstChildWhichIsA("SurfaceGui", true)
    if gui then
        for _, lbl in ipairs(gui:GetDescendants()) do
            if lbl:IsA("TextLabel") and lbl.Text
            and lbl.Text ~= "" and lbl.Text ~= "Empty Base" then
                return (lbl.Text:match("^(.-)'") or lbl.Text):gsub("%s*Base$", "")
            end
        end
    end
    return "?"
end

local function scan()
    local results = {}

    -- Catalog
    local catalog = {}
    if AnimalsData then
        for idx, info in pairs(AnimalsData) do
            if type(info) == "table" then
                if info.DisplayName then
                    catalog[info.DisplayName:lower()] = idx
                end
                catalog[tostring(idx):lower()] = idx
            end
        end
    end

    -- Methode 1: Synchronizer Bypass
    local syncUsed = false
    if _syncChannels then
        syncUsed = true
        for _, ch in next, _syncChannels do
            if type(ch) ~= "table" then continue end
            local owner = readChannel(ch, "Owner")
            if ownerIsMe(owner) then continue end
            local al = readChannel(ch, "AnimalList")
            if type(al) ~= "table" then continue end

            local ownerStr = resolveOwner(owner)
            for slot, ad in pairs(al) do
                if type(ad) ~= "table" then continue end
                local idx = ad.Index
                if not idx then continue end
                local info = AnimalsData and AnimalsData[idx]
                if not info then continue end
                if info.Egg or info.LuckyBlock then continue end
                local mut = ad.Mutation or "None"
                local gen = calcGen(idx, mut)
                local disp = info.DisplayName or idx
                table.insert(results, {
                    name = disp,
                    gen = gen,
                    genText = fmt(gen),
                    owner = ownerStr,
                    mutation = mut,
                    source = "sync"
                })
            end
        end
    end

    -- Methode 2: Visual Fallback
    local plots = Workspace:FindFirstChild("Plots")
    if plots then
        local seen = {}
        for _, plot in ipairs(plots:GetChildren()) do
            if isMyPlotVisual(plot) then continue end
            local ownerStr = getOwnerVisual(plot)

            -- Alle Descendants scannen
            for _, obj in ipairs(plot:GetDescendants()) do
                if not obj:IsA("Model") then continue end
                if seen[obj] then continue end

                local name = obj.Name
                local idx = catalog[name:lower()]

                if not idx then
                    local a = obj:GetAttribute("Index") or obj:GetAttribute("Animal")
                    if a then idx = catalog[tostring(a):lower()] end
                end

                if not idx then continue end
                local info = AnimalsData[idx]
                if not info or info.Egg or info.LuckyBlock then continue end

                seen[obj] = true

                -- Duplikat-Check gegen Sync-Ergebnisse
                local disp = info.DisplayName or idx
                local dup = false
                if syncUsed then
                    for _, r in ipairs(results) do
                        if r.name == disp and r.owner:lower():find(ownerStr:lower():sub(1, 4)) then
                            dup = true; break
                        end
                    end
                end
                if dup then continue end

                local mut = obj:GetAttribute("Mutation") or "None"
                local gen = calcGen(idx, mut)

                table.insert(results, {
                    name = disp,
                    gen = gen,
                    genText = fmt(gen),
                    owner = ownerStr,
                    mutation = mut,
                    source = "visual"
                })
            end
            task.wait()
        end
    end

    table.sort(results, function(a, b)
        if a.source ~= b.source then
            return a.source == "sync"
        end
        return a.gen > b.gen
    end)

    return results
end

